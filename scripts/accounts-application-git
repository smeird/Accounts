#!/usr/bin/env bash
set -euo pipefail

# Root-owned allowlist used by the authenticated Application Updates endpoint.
# Configuration is installed separately and is not writable by the web user.
readonly CONFIG_FILE="/etc/accounts-application-updater.conf"
[[ $EUID -eq 0 ]] || { echo "Updater helper must be invoked through sudo." >&2; exit 77; }
[[ -r "$CONFIG_FILE" ]] || { echo "Updater helper is not configured." >&2; exit 78; }

# shellcheck disable=SC1090
source "$CONFIG_FILE"
[[ ${APPLICATION_REPOSITORY:-} == /* && -d "$APPLICATION_REPOSITORY/.git" ]] || { echo "Configured repository is invalid." >&2; exit 78; }
[[ ${APPLICATION_OWNER:-} =~ ^[a-z_][a-z0-9_-]*[$]?$ ]] || { echo "Configured deployment user is invalid." >&2; exit 78; }
id "$APPLICATION_OWNER" >/dev/null 2>&1 || { echo "Configured deployment user does not exist." >&2; exit 78; }

git_as_owner() {
    runuser -u "$APPLICATION_OWNER" -- env \
        GIT_TERMINAL_PROMPT=0 \
        GIT_SSH_COMMAND='ssh -o BatchMode=yes' \
        git -c safe.directory="$APPLICATION_REPOSITORY" -C "$APPLICATION_REPOSITORY" "$@"
}

valid_branch() {
    [[ ${1:-} =~ ^[A-Za-z0-9._/-]+$ ]] && [[ "$1" != -* ]] && git check-ref-format --branch "$1" >/dev/null 2>&1
}

require_current_branch() {
    valid_branch "$1" || { echo "Invalid branch." >&2; exit 64; }
    local current
    current=$(git_as_owner symbolic-ref --quiet --short HEAD) || { echo "Detached checkout." >&2; exit 65; }
    [[ "$current" == "$1" ]] || { echo "Requested branch is not checked out." >&2; exit 65; }
}

# Every accepted shape mirrors one command generated by ApplicationUpdateService.
if [[ $# -eq 1 && $1 == "--version" ]]; then
    exec git --version
elif [[ $# -eq 2 && $1 == "rev-parse" && $2 == "--is-inside-work-tree" ]]; then
    git_as_owner "$@"
elif [[ $# -eq 4 && $1 == "symbolic-ref" && $2 == "--quiet" && $3 == "--short" && $4 == "HEAD" ]]; then
    git_as_owner "$@"
elif [[ $# -eq 3 && $1 == "status" && $2 == "--porcelain" && $3 == "--untracked-files=normal" ]]; then
    git_as_owner "$@"
elif [[ $# -eq 3 && $1 == "remote" && $2 == "get-url" && $3 == "origin" ]]; then
    git_as_owner "$@"
elif [[ $# -eq 4 && $1 == "fetch" && $2 == "--prune" && $3 == "origin" ]]; then
    require_current_branch "$4"
    git_as_owner "$@"
elif [[ $# -eq 3 && $1 == "rev-parse" && $2 == "--verify" && $3 == refs/remotes/origin/* ]]; then
    branch=${3#refs/remotes/origin/}
    require_current_branch "$branch"
    git_as_owner "$@"
elif [[ $# -eq 4 && $1 == "rev-list" && $2 == "--left-right" && $3 == "--count" && $4 == HEAD...refs/remotes/origin/* ]]; then
    branch=${4#HEAD...refs/remotes/origin/}
    require_current_branch "$branch"
    git_as_owner "$@"
elif [[ $# -eq 3 && $1 == "rev-parse" && $2 == "--short=7" && $3 == "HEAD" ]]; then
    git_as_owner "$@"
elif [[ $# -eq 3 && $1 == "rev-parse" && $2 == "--short=7" && $3 == refs/remotes/origin/* ]]; then
    branch=${3#refs/remotes/origin/}
    require_current_branch "$branch"
    git_as_owner "$@"
elif [[ $# -eq 4 && $1 == "log" && $2 == "-1" && $3 == "--format=%cI" && $4 == "HEAD" ]]; then
    git_as_owner "$@"
elif [[ $# -eq 3 && $1 == "merge" && $2 == "--ff-only" && $3 == refs/remotes/origin/* ]]; then
    branch=${3#refs/remotes/origin/}
    require_current_branch "$branch"
    [[ -z $(git_as_owner status --porcelain --untracked-files=normal) ]] || { echo "Working tree changed before installation." >&2; exit 66; }
    read -r ahead behind < <(git_as_owner rev-list --left-right --count "HEAD...refs/remotes/origin/$branch")
    [[ "$ahead" == "0" && "$behind" =~ ^[1-9][0-9]*$ ]] || { echo "Branch is no longer eligible for a fast-forward update." >&2; exit 66; }
    git_as_owner "$@"
elif [[ $# -eq 3 && $1 == "diff" && $2 == "--name-only" && $3 =~ ^[0-9a-fA-F]{7,40}\.\.[0-9a-fA-F]{7,40}$ ]]; then
    git_as_owner "$@"
else
    echo "Git operation is not permitted by the application updater." >&2
    exit 64
fi
